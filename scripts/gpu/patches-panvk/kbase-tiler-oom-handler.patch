@@ -158,7 +158,8 @@
 struct pan_kmod_kbase_csf_group *
 pan_kmod_kbase_csf_group_create(struct pan_kmod_dev *dev, unsigned nr_queues,
                                 uint64_t compute_mask, uint64_t fragment_mask,
-                                uint8_t max_compute, uint8_t max_fragment, uint8_t priority);
+                                uint8_t max_compute, uint8_t max_fragment, uint8_t priority,
+                                bool tiler_oom_handler);
 void pan_kmod_kbase_csf_group_destroy(struct pan_kmod_kbase_csf_group *group);
 
 bool pan_kmod_kbase_csf_tiler_heap_create(struct pan_kmod_dev *dev, uint32_t chunk_size,
diff -ruN a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
--- a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c	2026-11-04 12:19:02.000000000 +0000
+++ b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c	2026-11-09 21:33:07.332064624 +0000
@@ -740,7 +740,9 @@
       queue->kbase_group = pan_kmod_kbase_csf_group_create(
          dev->kmod.dev, PANVK_SUBQUEUE_COUNT, phys_dev->compute_core_mask,
          phys_dev->fragment_core_mask, max_compute_cores, max_fragment_cores,
-         kbase_prio[group_priority]);
+         kbase_prio[group_priority],
+         /* The TILER_OOM handler programs every render pass points the fragment CS at. */
+         dev->tiler_oom.handlers_bo != NULL);
       if (!queue->kbase_group)
          return panvk_errorf(dev, VK_ERROR_INITIALIZATION_FAILED,
                              "Failed to create a scheduling group");
